# Copy this file to .env and fill in the values before running Docker Compose.

VITE_API_URL=/api

MONGODB_URI=

# Origin the browser uses to reach the app
CORS_ORIGIN=http://localhost

# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# How many days before activity feed entries expire
ACTIVITY_TTL_DAYS=14

# Your contact email. It's required by OpenStreetMap's Nominatim usage policy
CONTACT_EMAIL=your@email.com
